# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required in production for webhook → DB (tenant resolve + persist)
SUPABASE_SERVICE_ROLE_KEY=

# Auth: production enforces login on /dashboard unless set to false
ENFORCE_AUTH=true

# Platform admin emails (comma-separated) for /dashboard/admin
ADMIN_EMAILS=

# Email alerts (optional — Resend)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=DukanBot <onboarding@resend.dev>

# Never enable in production — seeds fake catalog/orders
NEXT_PUBLIC_DEMO_SEED=false

# Support WhatsApp shown to merchants on Connect WhatsApp page
NEXT_PUBLIC_SUPPORT_WA=923001234567

# OpenAI — gpt-4o-mini via lib/llm.ts
OPENAI_API_KEY=
LLM_MAX_CALLS_PER_HOUR=200

# WhatsApp Cloud API (fallback; prefer per-merchant columns in merchants)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dukanbot_verify

# Webhook URL to set in Meta:
# https://YOUR_DOMAIN/api/whatsapp/webhook
